# AgriSaarthi AI - Environment Variables Template
# Copy this file to .env.local for local development, and set these values in Vercel Dashboard for production.

# 1. Supabase Credentials (Public client-side configuration)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 2. AI Model Integration (Serverless API configuration)
GEMINI_API_KEY=your-google-gemini-api-key
